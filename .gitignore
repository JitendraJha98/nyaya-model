# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Experiment tracking
wandb/

# Model outputs / checkpoints — too large for git.
# The bare `!outputs/**/` is required: git cannot re-include .gitkeep files
# inside a directory that is itself excluded.
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Bulk data is not versioned in git (HF hub / dataset versioning instead).
# Exceptions: canonical statute DB, mappings, and the frozen eval set ARE versioned.
# As with outputs/, `!data/**/` keeps directories visitable so nested .gitkeep
# files can actually be re-included.
data/raw/**
data/hf/**
data/generated/**
data/validated/**
data/splits/**
data/splits_rag/**
data/splits_rag_v3/**
# regenerable: scripts/29 + scripts/19 -> scripts/30, deterministic
data/splits_v5/**
data/generated/grounding_v1.jsonl
data/dpo/**
!data/**/
!data/**/.gitkeep
# Human-authored, not re-downloadable — always versioned.
!data/raw/citizen_questions.txt

# OS
Thumbs.db
.DS_Store
data/canonical/.dense_cache/

# The Eval-v1 private half must never reach the public GitHub repo. See the
# honesty note in scripts/25_build_eval_v1.py: this is damage limitation, NOT
# a restored held-out set -- v0 is already public, so its questions are out.
data/eval/nyaya_eval_v1_private.jsonl
# The combined file carries the private rows too — only the public half is versioned.
data/eval/nyaya_eval_v1.jsonl

# Local HF release bundle (large binaries; MANIFEST.md documents contents)
release/
